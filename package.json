{
  "name": "bun-drive",
  "version": "1.0.0",
  "description": "Windows File Explorer Active Directory network share discovery and integration engine.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:exe": "bun build --compile --target=bun-windows-x64 --production --windows-hide-console src/standalone.ts --outfile build/staging/Bun-Drive.exe",
    "build:installer": "bun scripts/build-windows-installer.ts",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist build dist-installer installer/bun-drive.nsi",
    "lint": "tsc --noEmit",
    "test": "npx tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
